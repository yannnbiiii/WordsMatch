<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".GameOverOrder">

    <LinearLayout
        android:layout_width="220dp"
        android:layout_marginTop="150dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="50dp"
            android:text="GAME OVER!!!"
            android:layout_gravity="center"
            android:fontFamily="@font/american_captain"
            />

        <TextView
            android:id="@+id/benarText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Benar: 0"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/arca_majora_3_bold"
            android:textSize="20dp"
            android:layout_gravity="center"
            />

        <TextView
            android:id="@+id/rekorText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rekor: 0"
            android:fontFamily="@font/arca_majora_3_bold"
            android:textSize="20dp"
            android:layout_gravity="center"
            />

        <Button
            android:id="@+id/mainLagi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/main_color"
            app:cornerRadius="5dp"
            android:text="Main lagi"
            android:textSize="28dp"
            android:layout_marginTop="20dp"
            android:layout_gravity="center"
            android:fontFamily="@font/arca_majora_3_bold"
            android:paddingBottom="14dp"
            />

        <Button
            android:id="@+id/menuUtama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/main_color"
            app:cornerRadius="5dp"
            android:text="Menu utama"
            android:textSize="28dp"
            android:layout_marginTop="5dp"
            android:layout_gravity="center"
            android:fontFamily="@font/arca_majora_3_bold"
            android:paddingBottom="14dp"
            />
    </LinearLayout>

</LinearLayout>