<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <TextView
            android:layout_width="270dp"
            android:layout_height="63dp"
            android:layout_gravity="center"
            android:layout_marginTop="125dp"
            android:layout_marginBottom="0dp"
            android:fontFamily="@font/american_captain"
            android:text="@string/app_name"
            android:textSize="60dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="10dp"
            android:text="COCOKAN KATA INGGRIS DENGAN ARTINYA"
            android:fontFamily="@font/arca_majora_3_bold"
            android:layout_gravity="center"

            />

        <TextView
            android:id="@+id/tvBestScore"
            android:layout_width="308dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="100dp"
            android:fontFamily="@font/american_captain"
            android:text="Best score: 0"
            android:textAlignment="center"
            android:layout_marginBottom="12dp"
            android:textSize="40dp" />

    </LinearLayout>
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center"
        >


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_gravity="center"
            >

            <Button
                android:id="@+id/preveus"
                android:layout_width="60dp"
                android:layout_height="60dp"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:text="&lt;"
                android:textSize="30sp"
                android:textColor="@color/main_color"
                android:fontFamily="@font/american_captain"
                />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"

                >

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/arca_majora_3_bold"
                    android:text="TINGKAT KESULITAN"
                    android:textSize="8sp"
                    android:layout_gravity="center"

                    />

                <Button
                    android:id="@+id/btnModeTeks"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:insetTop="-8dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:backgroundTint="@color/white"
                    android:text="EASY"
                    android:textColor="@color/main_color"
                    android:fontFamily="@font/american_captain"
                    android:layout_gravity="center"
                    android:textSize="29sp"

                    />
            </LinearLayout>


            <Button
                android:id="@+id/next"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:text="&gt;"
                android:textSize="30sp"
                android:textColor="@color/main_color"
                android:fontFamily="@font/american_captain"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                />

        </LinearLayout>

        <Button
            android:id="@+id/buttonStart"
            android:layout_width="195dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:backgroundTint="#4A4A4A"
            android:text="Mulai"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/american_captain"
            android:textSize="25dp"
            app:cornerRadius="5dp"


            />



    </LinearLayout>
    <!-- 215dp-->
    <LinearLayout
        android:layout_width="215dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal"
        android:weightSum="10">

        <Button
            android:id="@+id/buttonLeaderboard"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="7"
            android:backgroundTint="#4A4A4A"
            android:fontFamily="@font/american_captain"
            android:text="Leaderboard"
            android:textSize="20dp"
            app:cornerRadius="5dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonKontak"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="2"
            android:backgroundTint="#4A4A4A"
            app:cornerRadius="5dp"
            app:icon="@drawable/ic_kontak"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="@color/white" />



    </LinearLayout>

    <TextView
        android:id="@+id/sapaUser"
        android:layout_width="251dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="80dp"
        android:fontFamily="@font/arca_majora_3_bold"
        android:text="Selamat bermain Fidel! "
        android:textAlignment="center"
        android:textColor="@color/main_color"
        android:textSize="20dp"
        />
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/arca_majora_3_bold"
        android:text="Jadilah pemain papan Atas!"
        android:textAlignment="center"
        android:textColor="@color/main_color"
        android:textSize="10dp"
        android:layout_gravity="center"
        />
</LinearLayout>