<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".GameMenu">



    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TAP PASANGAN YANG COCOK"
        android:fontFamily="@font/american_captain"
        android:layout_gravity="center"
        android:textSize="35dp"
        android:layout_marginTop="80dp"
        android:textAlignment="center"
        />

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_gravity="center"
        android:layout_marginTop="15dp"
        >

        <TextView
            android:id="@+id/benar_saat_ini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/benar_saat_ini"
            android:layout_marginLeft="10dp"
            android:textSize="18dp"
            android:fontFamily="@font/arca_majora_3_bold"
            />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            />

        <TextView
            android:id="@+id/rekor_saat_ini"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/arca_majora_3_bold"
            android:text="@string/rekor_text"
            android:layout_marginRight="10dp"
            android:textSize="18dp" />

    </LinearLayout>

    <LinearLayout
        android:layout_width="300dp"
        android:layout_height="328dp"
        android:layout_gravity="center"
        android:layout_marginTop="40dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/div2btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >
            <Button
                android:layout_width="140dp"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/main_color"
                android:fontFamily="@font/arca_majora_3_bold"
                android:text="Priview"
                android:textSize="18dp"
                app:cornerRadius="8dp"
                android:paddingBottom="14dp"
                />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="300dp"
        android:layout_gravity="center"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        >


        <Button
            android:id="@+id/refreshBtn"
            android:layout_width="143dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:backgroundTint="@color/main_color"
            android:fontFamily="@font/arca_majora_3_bold"
            android:paddingBottom="14dp"
            android:text="Refresh 3x"
            android:textSize="18dp"
            app:cornerRadius="4dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginLeft="40dp"

            android:orientation="vertical">

            <TextView
                android:id="@+id/nyawa"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:fontFamily="@font/arca_majora_3_bold"
                android:text="NYAWA"
                android:textColor="@color/main_color"
                android:textSize="25dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Jika salah nyawa berkurang dan"
                android:textSize="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:text="Jika nyawa habis game over"
                android:textSize="8dp" />
        </LinearLayout>

    </LinearLayout>
    <TextView
        android:id="@+id/notifBenar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bagus! benar+1"
        android:layout_gravity="center"
        android:fontFamily="@font/arca_majora_3_bold"
        android:textSize="20dp"
        android:layout_marginTop="55dp"
        android:textColor="@color/main_color"
        android:visibility="invisible"
        />
</LinearLayout>